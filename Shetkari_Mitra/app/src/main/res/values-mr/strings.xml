    <!-- Onboarding -->
    <string name="onboarding_title_1">सर्पांपासून सुरक्षित राहा</string>
    <string name="onboarding_subtitle_1">सावधगिरी व प्रतिबंध</string>
    <string name="onboarding_desc_1">शेतात काम करताना बॅटरीचा वापर, गमबूट आणि सर्पांचा सामना टाळण्यासाठी मार्गदर्शक तत्त्वे.</string>
    <string name="onboarding_badge_1">प्रतिबंध</string>

    <string name="onboarding_title_2">आपत्कालीन कृती आराखडा</string>
    <string name="onboarding_subtitle_2">तातडीचे प्रथमोपचार</string>
    <string name="onboarding_desc_2">सर्पदंश झाल्यास काय करावे आणि चुकीच्या अंधश्रद्धा कशा टाळाव्यात ते जाणून घ्या.</string>
    <string name="onboarding_badge_2">तात्काळ प्रतिसाद</string>

    <string name="onboarding_title_3">जवळचे रुग्णालय व सर्पमित्र</string>
    <string name="onboarding_subtitle_3">तातडीची मदत</string>
    <string name="onboarding_desc_3">अँटी-व्हेनम उपलब्ध असणारी जवळची रुग्णालये व अधिकृत सर्पमित्रांशी थेट संपर्क करा.</string>
    <string name="onboarding_badge_3">मदत मिळवा</string>

    <string name="onboarding_title_4">आपली भाषा निवडा</string>
    <string name="onboarding_subtitle_4">भाषा निवड</string>
    <string name="onboarding_desc_4">आपली पसंतीची भाषा निवडा. आपण ही भाषा नंतरही बदलू शकता.</string>
    <string name="onboarding_badge_4">भाषा</string>

