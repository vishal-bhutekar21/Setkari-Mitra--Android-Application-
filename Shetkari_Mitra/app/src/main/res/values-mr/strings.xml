    <!-- Privacy Policy -->
    <string name="privacy_policy_title">गोपनीयता धोरण व डेटा सुरक्षा</string>
    <string name="privacy_policy_content">शेतकरी मित्र आपल्या गोपनीयतेचा आदर करतो.\n\n१. लोकेशन डेटा: फक्त जवळची रुग्णालये शोधण्यासाठी व सर्पमित्रांना मार्गदर्शन करण्यासाठी स्थानिक पातळीवर वापरला जातो. डेटा कोठेही विकला जात नाही.\n\n२. आपत्कालीन संपर्क: आपल्या फोनमध्येच सुरक्षित राहतात.\n\n३. शून्य ट्रॅकिंग: हे ॲप पूर्णपणे विनामूल्य व समाजोपयोगी आहे.</string>
    <string name="btn_agree">मला समजले</string>

