<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_24">

    <!-- Glass Illustration Container -->
    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_glass_circle_btn"
        android:gravity="center"
        android:padding="@dimen/space_24">

        <ImageView
            android:id="@+id/ivSlideIllustration"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:scaleType="fitCenter"
            android:src="@drawable/app_logo" />

    </LinearLayout>

    <!-- Glass Content Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_32"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_20">

        <!-- Category Badge -->
        <TextView
            android:id="@+id/tvSlideBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/dot_active"
            android:backgroundTint="@color/color_primary_container"
            android:fontFamily="@font/poppins_semibold"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingVertical="@dimen/space_4"
            android:text="PROTECT &amp; PREVENT"
            android:textColor="@color/color_on_primary_container"
            android:textSize="@dimen/text_caption" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvSlideTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:fontFamily="@font/poppins_bold"
            android:text="Instant Snake Guide"
            android:textAlignment="center"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_headline" />

        <!-- Marathi Title -->
        <TextView
            android:id="@+id/tvSlideMarathi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:fontFamily="@font/poppins_semibold"
            android:text="सर्पांची अचूक ओळख व माहिती"
            android:textAlignment="center"
            android:textColor="@color/color_primary"
            android:textSize="@dimen/text_body" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvSlideDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:fontFamily="@font/poppins_regular"
            android:lineSpacingMultiplier="1.3"
            android:text="Identify venomous vs harmless snakes with high-definition visual guides and photo assistance."
            android:textAlignment="center"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_body" />

    </LinearLayout>

</LinearLayout>
