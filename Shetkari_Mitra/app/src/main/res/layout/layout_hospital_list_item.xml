<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.ShetkariMitra.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
    android:layout_marginVertical="@dimen/space_8"
    app:cardBackgroundColor="@color/color_surface"
    app:strokeColor="@color/color_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header: Hospital Name & Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon_size_medium"
                android:layout_height="@dimen/icon_size_medium"
                android:src="@drawable/hospital_location_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hospitalNameTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_body_large" />

                <TextView
                    android:id="@+id/tvHospitalStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/dot_active"
                    android:backgroundTint="@color/color_success_container"
                    android:fontFamily="@font/poppins_semibold"
                    android:paddingHorizontal="@dimen/space_8"
                    android:paddingVertical="@dimen/space_2"
                    android:text="✓ ASV Verified • Call Before Travelling"
                    android:textColor="@color/color_success"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Location / Taluka -->
        <TextView
            android:id="@+id/talukaDistrictTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/color_primary"
            android:textSize="@dimen/text_body" />

        <!-- Address -->
        <TextView
            android:id="@+id/addressTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_caption" />

        <!-- Contact Person -->
        <TextView
            android:id="@+id/contactPersonTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/color_text_hint"
            android:textSize="@dimen/text_caption" />

        <!-- Phone Number -->
        <TextView
            android:id="@+id/hospitalNumberTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_body" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCallHospital"
                style="@style/Widget.ShetkariMitra.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_8"
                android:text="Call Hospital"
                android:textSize="@dimen/text_caption" />

            <Button
                android:id="@+id/btnViewOnMap"
                style="@style/Widget.ShetkariMitra.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="View on Map"
                android:textSize="@dimen/text_caption" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
