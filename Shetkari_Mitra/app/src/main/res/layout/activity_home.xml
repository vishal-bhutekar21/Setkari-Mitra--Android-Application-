        android:background="@color/color_surface"
        app:headerLayout="@layout/navigation_drawer_header"
        app:itemIconTint="@color/nav_drawer_item_text_color"
        app:itemTextColor="@color/nav_drawer_item_text_color"
        app:itemShapeFillColor="@color/nav_drawer_item_bg_color"
        app:itemShapeAppearanceOverlay="@style/Shape.ShetkariMitra.Medium"
        app:menu="@menu/navigation_drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>