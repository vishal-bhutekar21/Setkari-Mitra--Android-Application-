<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <!-- Coordinator Layout for content and floating Bottom Nav -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Custom Frosted Glass Top App Bar -->
            <LinearLayout
                android:id="@+id/customTopBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/color_primary"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingTop="@dimen/space_16"
                android:paddingBottom="@dimen/space_16">

                <!-- Row 1: Drawer Toggle, Title, Admin/Settings Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Glass Drawer Button -->
                    <ImageButton
                        android:id="@+id/btnMenuDrawer"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_glass_circle_btn"
                        android:contentDescription="Menu"
                        android:src="@drawable/profile_icon"
                        app:tint="@color/color_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Shetkari Mitra"
                            android:textColor="@color/color_on_primary"
                            android:textSize="@dimen/text_title_large" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="शेतकरी सुरक्षा आणि सर्पदंश निवारण"
                            android:textColor="@color/color_primary_container"
                            android:textSize="@dimen/text_caption" />

                    </LinearLayout>

                    <!-- Glass Emergency Direct SOS Call Button -->
                    <ImageButton
                        android:id="@+id/btnQuickEmergency"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_glass_emergency"
                        android:contentDescription="Emergency SOS"
                        android:src="@drawable/emergency_call_logo"
                        app:tint="@color/color_on_emergency" />

                </LinearLayout>

                <!-- Row 2: Location Glass Pill -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_12"
                    android:paddingVertical="@dimen/space_8">

                    <ImageView
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:src="@drawable/left_location_icon"
                        app:tint="@color/color_primary" />

                    <TextView
                        android:id="@+id/locationTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_semibold"
                        android:maxLines="1"
                        android:text="@string/location_jalna_default"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/dot_active"
                        android:backgroundTint="@color/color_success"
                        android:fontFamily="@font/poppins_bold"
                        android:paddingHorizontal="@dimen/space_8"
                        android:paddingVertical="@dimen/space_2"
                        android:text="GPS LIVE"
                        android:textColor="@color/color_on_primary"
                        android:textSize="@dimen/text_label" />

                </LinearLayout>

            </LinearLayout>

            <!-- Hidden dummy toolbar for standard action bar toggle -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Main Scrollable Dashboard -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:paddingBottom="100dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/screen_margin_horizontal">

                    <!-- Safety Status Hero Card -->
                    <LinearLayout
                        android:id="@+id/safetyStatusCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:background="@drawable/bg_glass_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_16">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/app_logo" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/dot_active"
                                    android:backgroundTint="@color/color_success" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_6"
                                    android:fontFamily="@font/poppins_bold"
                                    android:text="सुरक्षा कवच सक्रिय (Active)"
                                    android:textColor="@color/color_success"
                                    android:textSize="@dimen/text_caption" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:fontFamily="@font/poppins_bold"
                                android:text="25+ Hospitals in Jalna District"
                                android:textColor="@color/color_text_primary"
                                android:textSize="@dimen/text_body_large" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Anti-venom serum stock &amp; rescuers available"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="@dimen/text_caption" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Instant SOS Emergency Glass Banner -->
                    <LinearLayout
                        android:id="@+id/emergency_btn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:background="@drawable/bg_glass_emergency"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_16">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/emergency_call_logo"
                            app:tint="@color/color_on_emergency" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:text="EMERGENCY SOS: CALL 112"
                                android:textColor="@color/color_on_emergency"
                                android:textSize="@dimen/text_body_large" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Tap for immediate ambulance &amp; rescuer dispatch"
                                android:textColor="@color/color_emergency_container"
                                android:textSize="@dimen/text_caption" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/icon_size_medium"
                            android:layout_height="@dimen/icon_size_medium"
                            android:src="@drawable/call_logo"
                            app:tint="@color/color_on_emergency" />

                    </LinearLayout>

                    <!-- Section Header -->
                    <TextView
                        style="@style/TextAppearance.ShetkariMitra.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_20"
                        android:layout_marginBottom="@dimen/space_8"
                        android:text="Safety &amp; Rescue Services" />

                    <!-- 2x3 Grid of Glass Feature Cards -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:useDefaultMargins="true">

                        <!-- Snake Guide Card -->
                        <LinearLayout
                            android:id="@+id/Snake_Lib"
                            android:layout_width="0dp"
                            android:layout_height="132dp"
                            android:layout_columnWeight="1"
                            android:background="@drawable/bg_glass_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_12">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_feature_icon_circle"
                                android:padding="12dp"
                                android:src="@drawable/ic_feature_snakes" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_8"
                                android:fontFamily="@font/poppins_bold"
                                android:text="Snake Guide"
                                android:textColor="@color/color_text_primary"
                                android:textSize="@dimen/text_body" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="16 Species Catalog"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="@dimen/text_label" />

                        </LinearLayout>

                        <!-- First Aid Card -->
                        <LinearLayout
                            android:id="@+id/first_Aid"
                            android:layout_width="0dp"
                            android:layout_height="132dp"
                            android:layout_columnWeight="1"
                            android:background="@drawable/bg_glass_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_12">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_feature_icon_circle"
                                android:padding="12dp"
                                android:src="@drawable/ic_feature_first_aid" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_8"
                                android:fontFamily="@font/poppins_bold"
                                android:text="First Aid"
                                android:textColor="@color/color_text_primary"
                                android:textSize="@dimen/text_body" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Do's, Don'ts &amp; Care"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="@dimen/text_label" />

                        </LinearLayout>

                        <!-- Nearest Hospitals Card -->
                        <LinearLayout
                            android:id="@+id/nearhospital"
                            android:layout_width="0dp"
                            android:layout_height="132dp"
                            android:layout_columnWeight="1"
                            android:background="@drawable/bg_glass_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_12">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_feature_icon_circle"
                                android:padding="12dp"
                                android:src="@drawable/ic_feature_hospitals" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_8"
                                android:fontFamily="@font/poppins_bold"
                                android:text="Hospitals"
                                android:textColor="@color/color_text_primary"
                                android:textSize="@dimen/text_body" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Jalna &amp; Map Search"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="@dimen/text_label" />

                        </LinearLayout>

                        <!-- Identify Snake Card -->
                        <LinearLayout
                            android:id="@+id/Snake_identify"
                            android:layout_width="0dp"
                            android:layout_height="132dp"
                            android:layout_columnWeight="1"
                            android:background="@drawable/bg_glass_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_12">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_feature_icon_circle"
                                android:padding="12dp"
                                android:src="@drawable/ic_feature_identify" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_8"
                                android:fontFamily="@font/poppins_bold"
                                android:text="Identify Snake"
                                android:textColor="@color/color_text_primary"
                                android:textSize="@dimen/text_body" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Photo Expert Consult"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="@dimen/text_label" />

                        </LinearLayout>

                        <!-- Snake Rescuers Directory Card -->
                        <LinearLayout
                            android:id="@+id/snake_rescuer"
                            android:layout_width="0dp"
                            android:layout_height="132dp"
                            android:layout_columnWeight="1"
                            android:background="@drawable/bg_glass_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_12">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_feature_icon_circle"
                                android:padding="12dp"
                                android:src="@drawable/ic_feature_rescuers" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_8"
                                android:fontFamily="@font/poppins_bold"
                                android:text="Snake Rescuers"
                                android:textColor="@color/color_text_primary"
                                android:textSize="@dimen/text_body" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Sarpa Mitra Directory"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="@dimen/text_label" />

                        </LinearLayout>

                        <!-- Join Rescuers Registration Card -->
                        <LinearLayout
                            android:id="@+id/res_registration"
                            android:layout_width="0dp"
                            android:layout_height="132dp"
                            android:layout_columnWeight="1"
                            android:background="@drawable/bg_glass_card"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/space_12">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_feature_icon_circle"
                                android:padding="12dp"
                                android:src="@drawable/ic_feature_register" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_8"
                                android:fontFamily="@font/poppins_bold"
                                android:text="Join Rescuers"
                                android:textColor="@color/color_text_primary"
                                android:textSize="@dimen/text_body" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Register as Sarpa Mitra"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="@dimen/text_label" />

                        </LinearLayout>

                    </GridLayout>

                    <!-- Seasonal Farmer Advisory Glass Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:background="@drawable/bg_glass_card"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Field Safety Tip for Farmers"
                            android:textColor="@color/color_primary"
                            android:textSize="@dimen/text_body" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingMultiplier="1.3"
                            android:text="Always use a stick to rustle grass before entering crops or sheds. At night, keep your flashlight on and wear gumboots."
                            android:textColor="@color/color_text_secondary"
                            android:textSize="@dimen/text_caption" />

                    </LinearLayout>

                    <!-- Myths vs Facts Educational Card -->
                    <LinearLayout
                        android:id="@+id/cardMythsFacts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:background="@drawable/bg_glass_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_14">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_feature_icon_circle"
                            android:padding="10dp"
                            android:src="@drawable/ic_feature_myths" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:text="Myths vs Facts (गैरसमज व वास्तव)"
                                android:textColor="@color/color_text_primary"
                                android:textSize="@dimen/text_body" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Scientific snakebite facts &amp; awareness"
                                android:textColor="@color/color_primary"
                                android:textSize="@dimen/text_caption" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Read"
                            android:textColor="@color/color_primary"
                            android:textSize="@dimen/text_caption" />

                    </LinearLayout>

                    <!-- Harmful Agricultural Insects & Scorpions Card -->
                    <LinearLayout
                        android:id="@+id/cardInsectsCreatures"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:background="@drawable/bg_glass_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_14">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_feature_icon_circle"
                            android:padding="10dp"
                            android:src="@drawable/ic_feature_identify" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:text="Insects &amp; Scorpions (विंचू व कीटक)"
                                android:textColor="@color/color_text_primary"
                                android:textSize="@dimen/text_body" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Scorpion stings, blister beetles &amp; farm first aid"
                                android:textColor="@color/color_primary"
                                android:textSize="@dimen/text_caption" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Explore"
                            android:textColor="@color/color_primary"
                            android:textSize="@dimen/text_caption" />

                    </LinearLayout>

                    <!-- About App Button Card -->
                    <LinearLayout
                        android:id="@+id/about_btn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:background="@drawable/bg_glass_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_14">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_feature_icon_circle"
                            android:padding="10dp"
                            android:src="@drawable/ic_feature_about" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:text="About &amp; Developer"
                                android:textColor="@color/color_text_primary"
                                android:textSize="@dimen/text_body" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Vishal Bhutekar • IndiaSkills Gold Medalist"
                                android:textColor="@color/color_primary"
                                android:textSize="@dimen/text_caption" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="View"
                            android:textColor="@color/color_primary"
                            android:textSize="@dimen/text_caption" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

        <!-- Modern Floating Bottom Navigation Bar (Elevated 74dp with Material 3 Indicator) -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            style="@style/Widget.ShetkariMitra.BottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="@dimen/space_16"
            android:layout_marginBottom="@dimen/space_12"
            android:background="@drawable/bg_glass_bottom_nav"
            app:elevation="8dp"
            app:itemPaddingBottom="10dp"
            app:itemPaddingTop="10dp"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Side navigation drawer -->
