<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical"
    tools:context=".Acitivity_identify_snake">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingVertical="@dimen/space_12">

        <ImageButton
            android:id="@+id/btnGlassBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_circle_btn"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="@color/color_white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Snake Visual Identifier"
                android:textColor="@color/color_text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="Safe Distance Photography &amp; AI Aid"
                android:textColor="@color/color_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16"
            android:paddingBottom="@dimen/space_40">

            <!-- Safety Distance Warning Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/color_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_12">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Safety First"
                        android:textColor="@color/color_emergency"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingMultiplier="1.2"
                        android:text="Maintain at least 3 meters (10 feet) safe distance. Never corner or attempt to capture the snake."
                        android:textColor="@color/color_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Image Viewport Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="@dimen/space_14"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/color_border"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Captured Photo -->
                    <ImageView
                        android:id="@+id/imageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <!-- Empty State Placeholder -->
                    <LinearLayout
                        android:id="@+id/layoutEmptyPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_glass_circle_btn"
                            android:backgroundTint="@color/color_surface_variant"
                            android:padding="12dp"
                            android:src="@drawable/ic_camera_24"
                            app:tint="@color/color_primary" />

                        <TextView
                            android:id="@+id/tvTapToCaptureHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_10"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="No Photo Selected"
                            android:textColor="@color/color_text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="center"
                            android:text="Capture or pick from gallery from safe distance"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="11sp" />

                    </LinearLayout>

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons: Take Photo & Pick Gallery -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_14"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cameraBtn"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/space_4"
                    android:layout_weight="1"
                    android:backgroundTint="@color/color_primary"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Camera"
                    android:textColor="@color/color_white"
                    android:textSize="13sp"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_camera_24"
                    app:iconGravity="textStart"
                    app:iconTint="@color/color_white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/galleryBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="@dimen/space_4"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Gallery"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_gallery_24"
                    app:iconGravity="textStart"
                    app:iconTint="@color/color_primary"
                    app:strokeColor="@color/color_border" />
            </LinearLayout>

            <!-- Uncertainty-Aware Result Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardIdentificationResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:visibility="gone"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/color_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <!-- Possible Match Header & Confidence -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvMatchHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Possible Identification Match"
                            android:textColor="@color/color_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvConfidenceScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/dot_active"
                            android:backgroundTint="@color/color_primary_container"
                            android:fontFamily="@font/poppins_bold"
                            android:paddingHorizontal="@dimen/space_8"
                            android:paddingVertical="@dimen/space_2"
                            android:text="Confidence: 84%"
                            android:textColor="@color/color_on_primary_container"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Common & Scientific Name -->
                    <TextView
                        android:id="@+id/tvResultCommonName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Indian Rat Snake"
                        android:textColor="@color/color_text_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/tvResultScientificName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:text="Ptyas mucosa • Non-Venomous"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/space_8"
                        android:background="@color/color_divider" />

                    <!-- Key Traits & Habitat -->
                    <TextView
                        android:id="@+id/tvResultTraits"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingMultiplier="1.25"
                        android:text="Key features: Slender body, large eyes, black lip lines. Highly active in agricultural fields. Non-venomous and beneficial to farmers."
                        android:textColor="@color/color_text_secondary"
                        android:textSize="12sp" />

                    <!-- Visible Uncertainty Disclaimer -->
                    <TextView
                        android:id="@+id/tvResultDisclaimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_10"
                        android:background="@drawable/bg_venom_badge_non_venomous"
                        android:fontFamily="@font/poppins_regular"
                        android:padding="@dimen/space_8"
                        android:text="AI results are for guidance only. Treat every snake with caution and keep a safe distance."
                        android:textColor="@color/color_venomous"
                        android:textSize="11sp" />

                    <!-- Result Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnWhatShouldIDo"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:backgroundTint="@color/color_primary"
                            android:fontFamily="@font/poppins_bold"
                            android:text="What Should I Do?"
                            android:textColor="@color/color_white"
                            android:textSize="12sp"
                            app:cornerRadius="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_6"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFindRescuerActionResult"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="@dimen/space_4"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="Find Rescuer"
                                android:textColor="@color/color_text_primary"
                                android:textSize="11sp"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnLearnMoreActionResult"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="@dimen/space_4"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="Learn More"
                                android:textColor="@color/color_text_primary"
                                android:textSize="11sp"
                                app:cornerRadius="8dp"
                                app:strokeColor="@color/color_border" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Send to Expert via WhatsApp -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/sendBtn"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/space_16"
                android:backgroundTint="#25D366"
                android:fontFamily="@font/poppins_bold"
                android:text="Share Photo with Rescuer"
                android:textColor="@color/color_white"
                android:textSize="13sp"
                app:cornerRadius="10dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Global Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface"
        android:elevation="12dp"
        app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
        app:itemIconTint="@color/nav_item_color_state"
        app:itemTextColor="@color/nav_item_color_state"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>