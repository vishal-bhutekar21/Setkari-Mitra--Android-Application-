<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.ShetkariMitra.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <!-- Title & Regional Name -->
        <TextView
            android:id="@+id/tvPortalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/color_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvPortalMarathiTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/color_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDepartment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/color_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins_regular"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/color_text_secondary"
            android:textSize="12sp" />

        <!-- Actions: Open Portal & Call Helpline -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenPortal"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="@dimen/space_6"
                android:layout_weight="1"
                android:backgroundTint="@color/color_primary"
                android:fontFamily="@font/poppins_semibold"
                android:text="Open Portal"
                android:textColor="@color/color_white"
                android:textSize="12sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallHelpline"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="@dimen/space_6"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="Call Helpline"
                android:textColor="@color/color_primary"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/color_primary" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
