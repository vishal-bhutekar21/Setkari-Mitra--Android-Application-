<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_20">

    <LinearLayout
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_feature_icon_circle"
        android:backgroundTint="@color/color_primary_container"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivPermissionIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Permission Icon"
            android:src="@drawable/location_icon"
            app:tint="@color/color_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPermissionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_16"
        android:fontFamily="@font/poppins_bold"
        android:text="Location Permission"
        android:textColor="@color/color_text_primary"
        android:textSize="@dimen/text_headline" />

    <TextView
        android:id="@+id/tvPermissionReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:fontFamily="@font/poppins_regular"
        android:lineSpacingMultiplier="1.25"
        android:text="Location is required to find the nearest anti-venom hospitals and snake rescuers in your area."
        android:textColor="@color/color_text_secondary"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/tvPrivacyNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:background="@drawable/bg_venom_badge_non_venomous"
        android:fontFamily="@font/poppins_regular"
        android:padding="@dimen/space_8"
        android:text="🔒 Your location is only used locally to calculate distances and is never shared without your permission."
        android:textColor="@color/color_non_venomous"
        android:textSize="@dimen/text_caption" />

</LinearLayout>
