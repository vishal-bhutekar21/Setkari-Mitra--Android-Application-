<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_primary"
    android:orientation="vertical"
    android:padding="@dimen/space_20"
    android:paddingTop="@dimen/space_32">

    <!-- Avatar + Verified Shield Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp">

            <ImageView
                android:id="@+id/profile_picture"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_feature_icon_circle"
                android:backgroundTint="@color/color_primary_light"
                android:contentDescription="@string/app_name"
                android:padding="10dp"
                android:src="@drawable/user_circle"
                app:tint="@color/color_on_primary" />

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/dot_active"
                android:backgroundTint="@color/color_success" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/dot_active"
                android:backgroundTint="@color/color_primary_light"
                android:fontFamily="@font/poppins_bold"
                android:paddingHorizontal="@dimen/space_8"
                android:paddingVertical="@dimen/space_2"
                android:text="🛡️ Safety Shield Active"
                android:textColor="@color/color_on_primary"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Offline Mode Ready"
                android:textColor="@color/color_primary_container"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- User Name -->
    <TextView
        android:id="@+id/user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:fontFamily="@font/poppins_bold"
        android:text="शेतकरी मित्र (Shetkari Mitra)"
        android:textColor="@color/color_on_primary"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/user_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_regular"
        android:text="Rural Snake Safety &amp; Emergency Network"
        android:textColor="@color/color_primary_container"
        android:textSize="12sp" />

</LinearLayout>
