<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_primary"
    android:orientation="vertical"
    android:padding="@dimen/space_20"
    android:paddingTop="@dimen/space_32">

    <!-- Avatar + Status Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp">

            <ImageView
                android:id="@+id/profile_picture"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glass_circle_btn"
                android:backgroundTint="#26FFFFFF"
                android:contentDescription="@string/app_name"
                android:padding="12dp"
                android:src="@drawable/ic_person_outline_24"
                app:tint="@color/color_white" />

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/dot_active"
                android:backgroundTint="@color/color_success" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_14"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_circle_btn"
                android:backgroundTint="#26FFFFFF"
                android:fontFamily="@font/poppins_semibold"
                android:paddingHorizontal="@dimen/space_8"
                android:paddingVertical="@dimen/space_2"
                android:text="Safety Active"
                android:textColor="@color/color_white"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Offline Ready"
                android:textColor="@color/color_primary_container"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- User / App Title -->
    <TextView
        android:id="@+id/user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_14"
        android:fontFamily="@font/poppins_bold"
        android:text="@string/app_name"
        android:textColor="@color/color_white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/user_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_regular"
        android:text="Rural Snake Safety Network"
        android:textColor="@color/color_primary_container"
        android:textSize="12sp" />

</LinearLayout>
