<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_primary"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_16"
    android:paddingTop="32dp"
    android:paddingBottom="@dimen/space_20">

    <!-- Top Action Row: Avatar + Close Drawer Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- User Avatar Vector -->
        <FrameLayout
            android:id="@+id/avatarContainer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/profile_picture"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glass_circle_btn"
                android:backgroundTint="#26FFFFFF"
                android:contentDescription="@string/app_name"
                android:padding="11dp"
                android:src="@drawable/ic_person_outline_24"
                app:tint="@color/color_white" />
        </FrameLayout>

        <!-- Close Drawer Button (Bold White Left Arrow) -->
        <ImageButton
            android:id="@+id/btnDrawerClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_glass_circle_btn"
            android:backgroundTint="#26FFFFFF"
            android:contentDescription="Close Drawer"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="@color/color_white" />

    </RelativeLayout>

    <!-- User / App Title & Subtitle with Spacing -->
    <TextView
        android:id="@+id/user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:fontFamily="@font/poppins_bold"
        android:text="@string/app_name"
        android:textColor="@color/color_white"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/user_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/poppins_regular"
        android:text="Rural Snake Safety &amp; Emergency Network"
        android:textColor="@color/color_primary_container"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/dot_active"
        android:backgroundTint="#26FFFFFF"
        android:fontFamily="@font/poppins_bold"
        android:paddingHorizontal="@dimen/space_8"
        android:paddingVertical="2dp"
        android:text="VERIFIED SHEKARI ACCOUNT"
        android:textColor="@color/color_white"
        android:textSize="9.5sp" />

</LinearLayout>
