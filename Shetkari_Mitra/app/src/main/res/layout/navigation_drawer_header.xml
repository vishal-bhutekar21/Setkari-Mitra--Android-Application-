<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_24"
    android:background="@color/color_primary">

    <!-- Avatar Container -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp">

        <ImageView
            android:id="@+id/profile_picture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_feature_icon_circle"
            android:backgroundTint="@color/color_primary_light"
            android:padding="12dp"
            android:src="@drawable/user_circle"
            android:contentDescription="@string/app_name"
            app:tint="@color/color_on_primary" />

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/dot_active"
            android:backgroundTint="@color/color_success" />

    </FrameLayout>

    <!-- User Name -->
    <TextView
        android:id="@+id/user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:text="Shetkari Mitra"
        android:textSize="@dimen/text_title"
        android:textColor="@color/color_on_primary"
        android:fontFamily="@font/poppins_bold" />

    <!-- User Tagline / Safety Status -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/user_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Farmer Safety Shield Active"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/color_primary_container"
            android:fontFamily="@font/poppins_regular" />

    </LinearLayout>

</LinearLayout>
