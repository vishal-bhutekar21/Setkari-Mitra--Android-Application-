<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
    android:layout_marginVertical="@dimen/space_8"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Full-Width Wildlife Photo -->
        <ImageView
            android:id="@+id/ivCreaturePhoto"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:contentDescription="Creature Photo"
            android:scaleType="centerCrop"
            android:src="@drawable/red_scorpion" />

        <!-- Content Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <!-- Title & Secondary Name -->
            <TextView
                android:id="@+id/tvPrimaryName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Indian Red Scorpion"
                android:textColor="@color/color_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvSecondaryName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="तांबडा विंचू"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvScientificName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Mesobuthus tamulus • Scorpion"
                android:textColor="@color/color_primary"
                android:textSize="12sp"
                android:textStyle="italic" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/space_10"
                android:background="#F1F5F9" />

            <!-- Toxicity & Danger -->
            <TextView
                android:id="@+id/tvToxicityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Venom / Toxicity"
                android:textColor="@color/color_text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvToxicityInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_regular"
                android:lineSpacingMultiplier="1.2"
                android:text="Neurotoxic and cardiovascular venom causing severe pain."
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp" />

            <!-- Physical Markers -->
            <TextView
                android:id="@+id/tvIdentificationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:fontFamily="@font/poppins_bold"
                android:text="Physical Markers"
                android:textColor="@color/color_text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvIdentification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_regular"
                android:lineSpacingMultiplier="1.2"
                android:text="Orange-red to dark red-brown body, thick tail with sharp sting."
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp" />

            <!-- Farm Risk Areas -->
            <TextView
                android:id="@+id/tvHabitatLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:fontFamily="@font/poppins_bold"
                android:text="Farm Risk Areas"
                android:textColor="@color/color_text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvHabitat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_regular"
                android:lineSpacingMultiplier="1.2"
                android:text="Dry farm bunds, under stones, sugarcane husk, gum boots."
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp" />

            <!-- First Aid Protocol -->
            <TextView
                android:id="@+id/tvFirstAidLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:fontFamily="@font/poppins_bold"
                android:text="First Aid Protocol"
                android:textColor="@color/color_text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvFirstAid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_regular"
                android:lineSpacingMultiplier="1.2"
                android:text="Keep calm. Rush to hospital immediately for evaluation."
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp" />

            <!-- Prevention Tip -->
            <TextView
                android:id="@+id/tvPreventionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:fontFamily="@font/poppins_bold"
                android:text="Prevention Guide"
                android:textColor="@color/color_text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPrevention"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_regular"
                android:lineSpacingMultiplier="1.2"
                android:text="Always shake shoes and clothes before farm work. Use flashlight at night."
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
