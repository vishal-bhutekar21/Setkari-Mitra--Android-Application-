<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background"
    tools:context=".Activity_Myths_Facts">

    <!-- Top Bar with Glass Back Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingVertical="@dimen/space_12">

        <!-- Frosted Glass Back Button -->
        <ImageButton
            android:id="@+id/btnGlassBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_circle_btn"
            android:contentDescription="Back"
            android:src="@drawable/baseline_clear_24"
            app:tint="@color/color_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Myths vs Facts (गैरसमज व वास्तव)"
                android:textColor="@color/color_on_primary"
                android:textSize="@dimen/text_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="Scientific Snake Safety Awareness"
                android:textColor="@color/color_primary_container"
                android:textSize="@dimen/text_caption" />

        </LinearLayout>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16"
            android:paddingBottom="@dimen/space_40">

            <!-- Myth 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="❌ गैरसमज: सर्वच साप विषारी आणि प्राणघातक असतात."
                    android:textColor="@color/color_emergency"
                    android:textSize="@dimen/text_body_large" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:fontFamily="@font/poppins_semibold"
                    android:lineSpacingMultiplier="1.3"
                    android:text="✅ वास्तव: महाराष्ट्रातील 80% पेक्षा जास्त साप बिनविषारी असतात. फक्त 4 प्रमुख जाती (नाग, मण्यार, घोणस, फुरसे) मानवासाठी धोकादायक आहेत."
                    android:textColor="@color/color_success"
                    android:textSize="@dimen/text_body" />

            </LinearLayout>

            <!-- Myth 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="❌ गैरसमज: सर्पदंश झाल्यावर दोरीने घट्ट बांधल्यास जीव वाचतो."
                    android:textColor="@color/color_emergency"
                    android:textSize="@dimen/text_body_large" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:fontFamily="@font/poppins_semibold"
                    android:lineSpacingMultiplier="1.3"
                    android:text="✅ वास्तव: घट्ट बांधल्याने रक्तपुरवठा बंद होऊन अवयव कुजतो (गँगरीन) व हात-पाय कापावा लागतो. काठी बांधून अवयव स्थिर ठेवावा, घट्ट बांधू नये."
                    android:textColor="@color/color_success"
                    android:textSize="@dimen/text_body" />

            </LinearLayout>

            <!-- Myth 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="❌ गैरसमज: मांत्रिकाच्या झाडफुंक किंवा जडीबुटीने विष उतरते."
                    android:textColor="@color/color_emergency"
                    android:textSize="@dimen/text_body_large" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:fontFamily="@font/poppins_semibold"
                    android:lineSpacingMultiplier="1.3"
                    android:text="✅ वास्तव: मांत्रिकांकडे जाणारे रुग्ण बिनविषारी सापाचे असतात. विषारी सापावर केवळ Anti-Snake Venom (ASV) हेच एकमेव जीवनरक्षक औषध आहे."
                    android:textColor="@color/color_success"
                    android:textSize="@dimen/text_body" />

            </LinearLayout>

            <!-- Myth 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="❌ गैरसमज: जखमेवर ब्लेडने कापून किंवा तोंडाने विष चोखून काढता येते."
                    android:textColor="@color/color_emergency"
                    android:textSize="@dimen/text_body_large" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:fontFamily="@font/poppins_semibold"
                    android:lineSpacingMultiplier="1.3"
                    android:text="✅ वास्तव: विष तात्काळ रक्तवाहिन्यांत व लसिकेत पसरते. कापल्याने रक्तवाहिन्या खराब होतात व जंतूसंसर्ग होतो. तोंडाने चोखल्यास मदत करणाऱ्याचाही जीव धोक्यात येतो."
                    android:textColor="@color/color_success"
                    android:textSize="@dimen/text_body" />

            </LinearLayout>

            <!-- Myth 5 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="❌ गैरसमज: साप दूध पितो आणि बदला घेतो."
                    android:textColor="@color/color_emergency"
                    android:textSize="@dimen/text_body_large" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:fontFamily="@font/poppins_semibold"
                    android:lineSpacingMultiplier="1.3"
                    android:text="✅ वास्तव: साप मांसाहारी सरपटणारा प्राणी आहे, दूध पचवण्याची क्षमता त्यात नसते. सापाची स्मरणशक्ती सीमित असते, तो कधीही बदला घेत नाही."
                    android:textColor="@color/color_success"
                    android:textSize="@dimen/text_body" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
