<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <!-- OpenStreetMap View occupying entire screen -->
    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Floating Top Header with Glass Back Button and Title -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginHorizontal="@dimen/space_16"
        android:layout_marginTop="@dimen/space_16"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_8">

        <!-- Frosted Glass Back Button -->
        <ImageButton
            android:id="@+id/btnGlassBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_circle_btn"
            android:contentDescription="Back"
            android:src="@drawable/baseline_clear_24"
            app:tint="@color/color_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Hospital Map (Jalna)"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/text_body_large" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="OpenStreetMap Live Navigation"
                android:textColor="@color/color_primary"
                android:textSize="@dimen/text_caption" />

        </LinearLayout>

    </LinearLayout>

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Floating Glass Radius Filters at the Bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_24"
        android:background="@drawable/bg_glass_card"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/space_8">

        <Button
            android:id="@+id/button_2km"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_4"
            android:text="2 km"
            android:textColor="@color/color_primary"
            android:textSize="@dimen/text_caption" />

        <Button
            android:id="@+id/button_5km"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_4"
            android:text="5 km"
            android:textColor="@color/color_primary"
            android:textSize="@dimen/text_caption" />

        <Button
            android:id="@+id/button_10km"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_4"
            android:text="10 km"
            android:textColor="@color/color_primary"
            android:textSize="@dimen/text_caption" />

        <Button
            android:id="@+id/button_all"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="All Jalna"
            android:textColor="@color/color_primary"
            android:textSize="@dimen/text_caption" />

    </LinearLayout>

</RelativeLayout>
