<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <!-- OpenStreetMap View occupying entire screen -->
    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top App Bar & Layer Filters Container -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_primary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingVertical="@dimen/space_12">

            <!-- Frosted Glass Back Button -->
            <ImageButton
                android:id="@+id/btnGlassBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_glass_circle_btn"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back_24"
                app:tint="@color/color_white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMapHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Emergency Medical &amp; Rescuer Map"
                    android:textColor="@color/color_on_primary"
                    android:textSize="@dimen/text_title" />

                <TextView
                    android:id="@+id/tvMapHeaderSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Live ASV Hospitals &amp; Sarpmitra Network"
                    android:textColor="@color/color_primary_container"
                    android:textSize="@dimen/text_caption" />

            </LinearLayout>

        </LinearLayout>

        <!-- Category Layer Selector Row (Horizontal Scroll with Clean Spacing) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E6FFFFFF"
            android:clipToPadding="false"
            android:elevation="4dp"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingVertical="@dimen/space_8"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipAllLayers"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="@dimen/space_8"
                    android:backgroundTint="@color/color_primary"
                    android:fontFamily="@font/poppins_semibold"
                    android:paddingHorizontal="@dimen/space_12"
                    android:text="All Layers"
                    android:textColor="@color/color_on_primary"
                    android:textSize="12sp"
                    app:cornerRadius="@dimen/radius_full" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipHospitals"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="@dimen/space_8"
                    android:fontFamily="@font/poppins_semibold"
                    android:paddingHorizontal="@dimen/space_12"
                    android:text="Hospitals (25+)"
                    android:textColor="@color/color_primary"
                    android:textSize="12sp"
                    app:cornerRadius="@dimen/radius_full"
                    app:strokeColor="@color/color_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipRescuers"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="@dimen/space_8"
                    android:fontFamily="@font/poppins_semibold"
                    android:paddingHorizontal="@dimen/space_12"
                    android:text="Snake Rescuers"
                    android:textColor="@color/color_primary"
                    android:textSize="12sp"
                    app:cornerRadius="@dimen/radius_full"
                    app:strokeColor="@color/color_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipSightings"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:paddingHorizontal="@dimen/space_12"
                    android:text="Sightings"
                    android:textColor="@color/color_primary"
                    android:textSize="12sp"
                    app:cornerRadius="@dimen/radius_full"
                    app:strokeColor="@color/color_primary" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Floating Glass Radius Filters at the Bottom -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_20"
        app:cardBackgroundColor="@color/color_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="@dimen/space_8">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_2km"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="2 km"
                android:textColor="@color/color_primary"
                android:textSize="11sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_5km"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="5 km"
                android:textColor="@color/color_primary"
                android:textSize="11sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_10km"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="10 km"
                android:textColor="@color/color_primary"
                android:textSize="11sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_all"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.2"
                android:backgroundTint="@color/color_primary"
                android:fontFamily="@font/poppins_bold"
                android:text="All Jalna"
                android:textColor="@color/color_white"
                android:textSize="11sp"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>
