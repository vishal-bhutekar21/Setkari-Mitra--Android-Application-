<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <!-- OpenStreetMap View occupying entire screen -->
    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Floating Top Header with Glass Back Button and Title -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginHorizontal="@dimen/space_16"
        android:layout_marginTop="@dimen/space_16"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="@dimen/space_8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Frosted Glass Back Button -->
            <ImageButton
                android:id="@+id/btnGlassBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_glass_circle_btn"
                android:contentDescription="Back"
                android:src="@drawable/baseline_clear_24"
                app:tint="@color/color_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMapHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Emergency Medical &amp; Rescuer Map"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_body_large" />

                <TextView
                    android:id="@+id/tvMapHeaderSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Live ASV Hospitals &amp; Sarpmitra Network"
                    android:textColor="@color/color_primary"
                    android:textSize="@dimen/text_caption" />

            </LinearLayout>

        </LinearLayout>

        <!-- Category Selector Chips (All, Hospitals, Rescuers) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipAllLayers"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1"
                android:backgroundTint="@color/color_primary"
                android:fontFamily="@font/poppins_semibold"
                android:text="All (सर्व)"
                android:textColor="@color/color_on_primary"
                android:textSize="11sp"
                app:cornerRadius="@dimen/radius_full" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipHospitals"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="Hospitals"
                android:textColor="@color/color_emergency"
                android:textSize="11sp"
                app:cornerRadius="@dimen/radius_full"
                app:strokeColor="@color/color_emergency" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipRescuers"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="Rescuers"
                android:textColor="@color/color_primary"
                android:textSize="10sp"
                app:cornerRadius="@dimen/radius_full"
                app:strokeColor="@color/color_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipSightings"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="Sightings"
                android:textColor="@color/color_warning"
                android:textSize="10sp"
                app:cornerRadius="@dimen/radius_full"
                app:strokeColor="@color/color_warning" />

        </LinearLayout>

    </LinearLayout>

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Floating Glass Radius Filters at the Bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_24"
        android:background="@drawable/bg_glass_card"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/space_8">

        <Button
            android:id="@+id/button_2km"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_4"
            android:text="2 km"
            android:textColor="@color/color_primary"
            android:textSize="@dimen/text_caption" />

        <Button
            android:id="@+id/button_5km"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_4"
            android:text="5 km"
            android:textColor="@color/color_primary"
            android:textSize="@dimen/text_caption" />

        <Button
            android:id="@+id/button_10km"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_4"
            android:text="10 km"
            android:textColor="@color/color_primary"
            android:textSize="@dimen/text_caption" />

        <Button
            android:id="@+id/button_all"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="All Jalna"
            android:textColor="@color/color_primary"
            android:textSize="@dimen/text_caption" />

    </LinearLayout>

</RelativeLayout>
