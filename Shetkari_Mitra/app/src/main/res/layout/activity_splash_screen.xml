<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_primary">

    <!-- Center Minimal Brand Container -->
    <LinearLayout
        android:id="@+id/centerStage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_24">

        <!-- Minimal Vector Emblem Container -->
        <FrameLayout
            android:id="@+id/logoWrapper"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_glass_circle_btn">

            <ImageView
                android:id="@+id/ivShieldLogo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="Shetkari Mitra Emblem"
                android:src="@drawable/ic_hospital_shield_24"
                app:tint="@color/color_white" />
        </FrameLayout>

        <!-- App Name -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:fontFamily="@font/poppins_bold"
            android:letterSpacing="0.02"
            android:text="Shetkari Mitra"
            android:textColor="@color/color_white"
            android:textSize="26sp" />

        <!-- Marathi Subtitle -->
        <TextView
            android:id="@+id/tvAppMarathiName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/poppins_regular"
            android:text="शेतकरी सुरक्षा आणि सर्पदंश निवारण"
            android:textColor="@color/color_primary_container"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Bottom Minimal Footer -->
    <TextView
        android:id="@+id/tvTrustBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/space_24"
        android:fontFamily="@font/poppins_regular"
        android:text="Maharashtra Farmer Safety Initiative"
        android:textColor="#90FFFFFF"
        android:textSize="11sp" />

</RelativeLayout>
