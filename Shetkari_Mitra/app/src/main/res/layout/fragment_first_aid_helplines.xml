<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16"
        android:paddingBottom="@dimen/space_40">

        <!-- Title -->
        <TextView
            style="@style/TextAppearance.ShetkariMitra.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24x7 Emergency Helplines"
            android:textColor="@color/color_primary" />

        <TextView
            style="@style/TextAppearance.ShetkariMitra.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="Tap any card to initiate direct emergency call" />

        <!-- Helpline 1: 108 Free Ambulance -->
        <LinearLayout
            android:id="@+id/cardCall108"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_glass_emergency"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_16">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/emergency_call_logo"
                app:tint="@color/color_on_emergency" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="108 — Free Emergency Ambulance"
                    android:textColor="@color/color_on_emergency"
                    android:textSize="@dimen/text_body_large" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="महाराष्ट्र शासन मोफत रुग्णवाहिका सेवा (24x7)"
                    android:textColor="@color/color_emergency_container"
                    android:textSize="@dimen/text_caption" />

            </LinearLayout>

            <ImageButton
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_glass_circle_btn"
                android:contentDescription="Call"
                android:src="@drawable/call_logo"
                app:tint="@color/color_emergency" />

        </LinearLayout>

        <!-- Helpline 2: 112 National Emergency SOS -->
        <LinearLayout
            android:id="@+id/cardCall112"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_glass_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_16">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/call_logo"
                app:tint="@color/color_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="112 — National Emergency All-in-One"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_body_large" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Police, Disaster &amp; Rapid Medical Response"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_caption" />

            </LinearLayout>

            <ImageButton
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_glass_circle_btn"
                android:contentDescription="Call"
                android:src="@drawable/call_logo"
                app:tint="@color/color_primary" />

        </LinearLayout>

        <!-- Helpline 3: 1926 Forest Dept Wildlife Rescue -->
        <LinearLayout
            android:id="@+id/cardCall1926"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_glass_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_16">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/snake_rescure"
                app:tint="@color/color_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="1926 — Maharashtra Forest Dept"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_body_large" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="24x7 Wildlife Rescue &amp; Sarpa Mitra Coordination"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_caption" />

            </LinearLayout>

            <ImageButton
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_glass_circle_btn"
                android:contentDescription="Call"
                android:src="@drawable/call_logo"
                app:tint="@color/color_primary" />

        </LinearLayout>

        <!-- Helpline 4: National Poison Information Centre -->
        <LinearLayout
            android:id="@+id/cardCallPoison"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_glass_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_16">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/first_aid_logo"
                app:tint="@color/color_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="1800-116-117 — Poison Control (AIIMS)"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_body_large" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="National Toxicology &amp; Anti-Venom Guidance"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_caption" />

            </LinearLayout>

            <ImageButton
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_glass_circle_btn"
                android:contentDescription="Call"
                android:src="@drawable/call_logo"
                app:tint="@color/color_primary" />

        </LinearLayout>

        <!-- Helpline 5: Jalna District Civil Hospital Anti-Venom -->
        <LinearLayout
            android:id="@+id/cardCallJalnaCivil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_glass_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_16">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/hospital_location_logo"
                app:tint="@color/color_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="02482-225600 — Jalna District Hospital"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_body_large" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Civil Hospital Jalna Anti-Venom Emergency Desk"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/text_caption" />

            </LinearLayout>

            <ImageButton
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_glass_circle_btn"
                android:contentDescription="Call"
                android:src="@drawable/call_logo"
                app:tint="@color/color_primary" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
