<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_40">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Image Container -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="270dp">

                <ImageView
                    android:id="@+id/detailImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/p2" />

                <!-- Floating Frosted Glass Back Button -->
                <ImageButton
                    android:id="@+id/btnGlassBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_margin="@dimen/space_16"
                    android:background="@drawable/bg_glass_circle_btn"
                    android:contentDescription="Back"
                    android:src="@drawable/baseline_clear_24"
                    app:tint="@color/color_primary" />

                <!-- Floating Language Switcher Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetailLangToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="@dimen/space_16"
                    android:backgroundTint="@color/color_surface"
                    android:fontFamily="@font/poppins_bold"
                    android:paddingHorizontal="@dimen/space_14"
                    android:text="मराठी"
                    android:textColor="@color/color_primary"
                    android:textSize="@dimen/text_caption"
                    app:cornerRadius="@dimen/radius_full"
                    app:strokeColor="@color/color_primary"
                    app:strokeWidth="1.5dp" />

            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_margin_horizontal"
                android:paddingTop="@dimen/space_16">

                <!-- Title & Identity Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/detailTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_bold"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/text_headline" />

                        <TextView
                            android:id="@+id/detailVenomBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_glass_button"
                            android:fontFamily="@font/poppins_bold"
                            android:paddingHorizontal="@dimen/space_12"
                            android:paddingVertical="@dimen/space_6"
                            android:text="Venomous"
                            android:textColor="@color/color_on_primary"
                            android:textSize="@dimen/text_caption" />

                    </LinearLayout>

                    <!-- Scientific Name -->
                    <TextView
                        android:id="@+id/detailScientificName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/color_primary"
                        android:textSize="@dimen/text_body"
                        android:textStyle="italic" />

                    <!-- Overview Summary Text -->
                    <TextView
                        android:id="@+id/detailDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingMultiplier="1.4"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="@dimen/text_body" />

                </LinearLayout>

                <!-- Section 1: Key Quick Facts (Venom Nature) Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_14"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:id="@+id/tvHeaderVenomType"
                        style="@style/TextAppearance.ShetkariMitra.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Venom Classification &amp; Toxicity"
                        android:textColor="@color/color_primary" />

                    <TextView
                        android:id="@+id/detailVenomType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:fontFamily="@font/poppins_semibold"
                        android:lineSpacingMultiplier="1.35"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_body" />

                </LinearLayout>

                <!-- Section 2: Identification & Physical Markers Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_14"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:id="@+id/tvHeaderIdentification"
                        style="@style/TextAppearance.ShetkariMitra.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How to Identify (Physical Markers)"
                        android:textColor="@color/color_primary" />

                    <TextView
                        android:id="@+id/detailIdentification"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingMultiplier="1.4"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="@dimen/text_body" />

                </LinearLayout>

                <!-- Section 3: Where It Is Found & Regional Habitat Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_14"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:id="@+id/tvHeaderHabitat"
                        style="@style/TextAppearance.ShetkariMitra.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Where It Is Found &amp; Regional Habitat"
                        android:textColor="@color/color_primary" />

                    <TextView
                        android:id="@+id/detailLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingMultiplier="1.4"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="@dimen/text_body" />

                </LinearLayout>

                <!-- Section 4: Behavior, Activity & Diet Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_14"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:id="@+id/tvHeaderDiet"
                        style="@style/TextAppearance.ShetkariMitra.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Diet &amp; Natural Prey"
                        android:textColor="@color/color_primary" />

                    <TextView
                        android:id="@+id/detailDiet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingMultiplier="1.4"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="@dimen/text_body" />

                </LinearLayout>

                <!-- Section 5: Farmer Safety & Agricultural Benefit Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_14"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:id="@+id/tvHeaderSafety"
                        style="@style/TextAppearance.ShetkariMitra.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Farmer Safety Precautions &amp; Benefits"
                        android:textColor="@color/color_primary" />

                    <TextView
                        android:id="@+id/detailSafetyTips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingMultiplier="1.4"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="@dimen/text_body" />

                </LinearLayout>

                <!-- Section 6: Immediate First Aid & Emergency Protocol Card -->
                <LinearLayout
                    android:id="@+id/cardFirstAidProtocol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_14"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:id="@+id/tvHeaderFirstAid"
                        style="@style/TextAppearance.ShetkariMitra.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bite Response &amp; First Aid Protocol"
                        android:textColor="@color/color_emergency" />

                    <TextView
                        android:id="@+id/detailFirstAid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingMultiplier="1.4"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/text_body" />

                </LinearLayout>

                <!-- Action Buttons: Hospital GPS & Rescuer Directory -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFindHospital"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="@dimen/space_8"
                        android:layout_weight="1"
                        android:backgroundTint="@color/color_emergency"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Nearby ASV Hospital"
                        android:textColor="@color/color_on_emergency"
                        android:textSize="@dimen/text_caption"
                        app:cornerRadius="@dimen/radius_medium"
                        app:icon="@drawable/ic_feature_hospitals"
                        app:iconGravity="textStart"
                        app:iconTint="@color/color_on_emergency" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCallRescuer"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/color_primary"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Call Sarpmitra"
                        android:textColor="@color/color_on_primary"
                        android:textSize="@dimen/text_caption"
                        app:cornerRadius="@dimen/radius_medium"
                        app:icon="@drawable/ic_feature_rescuers"
                        app:iconGravity="textStart"
                        app:iconTint="@color/color_on_primary" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
