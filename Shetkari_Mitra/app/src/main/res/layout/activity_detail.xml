<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_40">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Image Container -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="270dp">

                <ImageView
                    android:id="@+id/detailImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/p2" />

                <!-- Back Button -->
                <ImageButton
                    android:id="@+id/btnGlassBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_margin="@dimen/space_16"
                    android:background="@drawable/bg_glass_circle_btn"
                    android:contentDescription="Back"
                    android:src="@drawable/baseline_clear_24"
                    app:tint="@color/color_primary" />

                <!-- Language Switcher Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetailLangToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="@dimen/space_16"
                    android:backgroundTint="@color/color_surface"
                    android:fontFamily="@font/poppins_bold"
                    android:paddingHorizontal="@dimen/space_14"
                    android:text="मराठी"
                    android:textColor="@color/color_primary"
                    android:textSize="12sp"
                    app:cornerRadius="@dimen/radius_full"
                    app:strokeColor="@color/color_primary"
                    app:strokeWidth="1.5dp" />

            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_margin_horizontal"
                android:paddingTop="@dimen/space_16">

                <!-- Title & Identity Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/color_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/detailTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_bold"
                                android:textColor="@color/color_text_primary"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/detailVenomBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_glass_button"
                                android:fontFamily="@font/poppins_bold"
                                android:paddingHorizontal="@dimen/space_12"
                                android:paddingVertical="@dimen/space_6"
                                android:text="Venomous"
                                android:textColor="@color/color_on_primary"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <!-- Scientific Name -->
                        <TextView
                            android:id="@+id/detailScientificName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="@color/color_primary"
                            android:textSize="13sp"
                            android:textStyle="italic" />

                        <!-- Overview Summary Text -->
                        <TextView
                            android:id="@+id/detailDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_10"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingMultiplier="1.4"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section 1: Key Quick Facts (Venom Nature) Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/color_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <TextView
                            android:id="@+id/tvHeaderVenomType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Venom Classification &amp; Toxicity"
                            android:textColor="@color/color_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/detailVenomType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_6"
                            android:fontFamily="@font/poppins_semibold"
                            android:lineSpacingMultiplier="1.35"
                            android:textColor="@color/color_text_primary"
                            android:textSize="13sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section 2: Identification & Physical Markers Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/color_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <TextView
                            android:id="@+id/tvHeaderIdentification"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Physical Characteristics &amp; Identification"
                            android:textColor="@color/color_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/detailIdentification"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_6"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingMultiplier="1.4"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section 3: Where It Is Found & Regional Habitat Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/color_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <TextView
                            android:id="@+id/tvHeaderHabitat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Habitat &amp; Regional Distribution"
                            android:textColor="@color/color_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/detailLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_6"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingMultiplier="1.4"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section 4: Behavior, Activity & Diet Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/color_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <TextView
                            android:id="@+id/tvHeaderDiet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Diet &amp; Temperament"
                            android:textColor="@color/color_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/detailDiet"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_6"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingMultiplier="1.4"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section 5: Farmer Safety & Agricultural Benefit Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/color_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <TextView
                            android:id="@+id/tvHeaderSafety"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Farmer Safety &amp; Ecological Importance"
                            android:textColor="@color/color_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/detailSafetyTips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_6"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingMultiplier="1.4"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section 6: Immediate First Aid & Emergency Protocol Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFirstAidProtocol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/color_emergency"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <TextView
                            android:id="@+id/tvHeaderFirstAid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="First Aid &amp; Emergency Protocol"
                            android:textColor="@color/color_emergency"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/detailFirstAid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_6"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingMultiplier="1.4"
                            android:textColor="@color/color_text_primary"
                            android:textSize="13sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action Buttons: Hospital GPS & Rescuer Directory -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFindHospital"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="@dimen/space_4"
                        android:layout_weight="1"
                        android:backgroundTint="@color/color_emergency"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Find Hospital"
                        android:textColor="@color/color_white"
                        android:textSize="12sp"
                        app:cornerRadius="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCallRescuer"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="@dimen/space_4"
                        android:layout_weight="1"
                        android:backgroundTint="@color/color_primary"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Find Rescuer"
                        android:textColor="@color/color_white"
                        android:textSize="12sp"
                        app:cornerRadius="10dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
