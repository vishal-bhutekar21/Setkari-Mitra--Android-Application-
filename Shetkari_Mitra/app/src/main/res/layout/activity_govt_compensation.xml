<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingVertical="@dimen/space_12">

        <ImageButton
            android:id="@+id/btnGlassBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_circle_btn"
            android:contentDescription="Back"
            android:src="@drawable/baseline_clear_24"
            app:tint="@color/color_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Government Insurance &amp; Relief Schemes"
                android:textColor="@color/color_on_primary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="शासकीय विमा व अपघात सहाय्यता योजना"
                android:textColor="@color/color_primary_container"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16"
            android:paddingBottom="@dimen/space_40">

            <!-- SCHEME 1: Gopinath Munde Shetkari Apghat Yojana -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="1. Gopinath Munde Shetkari Apghat Vima Yojana"
                        android:textColor="@color/color_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="गोपीनाथ मुंडे शेतकरी अपघात सुरक्षा सानुग्रह अनुदान (₹2,00,000)"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingMultiplier="1.25"
                        android:text="• Coverage: ₹2,00,000 for accidental death or permanent disability (Snakebite, Electric Shock, Drowning, Road Accident, Farm Machinery, Lightning).\n• Beneficiary: Registered farmers and their family members (10 to 75 years).\n• Application Window: Submit claim within 30 days to Taluka Krishi Adhikari (TKA) or Tahsildar Office.\n• Mandatory Documents: FIR/Police Panchanama, Post-Mortem (PM) Report, Death Certificate, 7/12 &amp; 8A Extract, Legal Heir Certificate."
                        android:textColor="@color/color_text_primary"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenMahaDbtScheme"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="@dimen/space_12"
                        android:backgroundTint="@color/color_primary"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Apply Online on MahaDBT"
                        android:textColor="@color/color_white"
                        android:textSize="12sp"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SCHEME 2: PMJJBY Life Insurance Scheme -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="2. Pradhan Mantri Jeevan Jyoti Bima Yojana (PMJJBY)"
                        android:textColor="@color/color_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="प्रधानमंत्री जीवन ज्योती विमा योजना (₹2,00,000 जीवन सुरक्षा)"
                        android:textColor="@color/color_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingMultiplier="1.25"
                        android:text="• Life Cover: ₹2,00,000 payable to nominee upon death of subscriber due to any cause.\n• Premium: Only ₹436 per annum, auto-debited from bank/post office savings account.\n• Eligibility: Any citizen aged 18 to 50 years with a bank account."
                        android:textColor="@color/color_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SCHEME 3: PMSBY Accidental Insurance -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="3. Pradhan Mantri Suraksha Bima Yojana (PMSBY)"
                        android:textColor="@color/color_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="प्रधानमंत्री सुरक्षा विमा योजना (₹2,00,000 अपघात विमा)"
                        android:textColor="@color/color_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingMultiplier="1.25"
                        android:text="• Accidental Benefit: ₹2,00,000 for accidental death or total permanent disability; ₹1,00,000 for partial permanent disability.\n• Premium: ₹20 per annum.\n• Eligibility: Citizens aged 18 to 70 years."
                        android:textColor="@color/color_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SCHEME 4: MJPJAY Free Health Scheme -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="4. Mahatma Jyotirao Phule Jan Arogya Yojana (MJPJAY)"
                        android:textColor="@color/color_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="महात्मा जोतीराव फुले जन आरोग्य योजना (₹5,00,000 मोफत उपचार)"
                        android:textColor="@color/color_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingMultiplier="1.25"
                        android:text="• Hospitalization Benefit: Up to ₹5,00,000 cashless treatment per family per year in impaneled government and private hospitals across Maharashtra.\n• ICU, ICU ventilator support, dialysis, and emergency antivenom intensive care covered.\n• Eligibility: All ration card holders (Yellow, Orange, White) and farmer families in Maharashtra."
                        android:textColor="@color/color_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SCHEME 5: Forest Department Wildlife Compensation -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="5. Maharashtra Forest Wildlife Attack Ex-Gratia Relief"
                        android:textColor="@color/color_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="वन विभाग वन्यजीव हल्ला सानुग्रह मदत (₹20,00,000 पर्यंत)"
                        android:textColor="@color/color_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingMultiplier="1.25"
                        android:text="• Ex-Gratia Relief: ₹20 Lakh in case of human loss of life due to wild animal attacks; ₹5 Lakh for permanent disability; up to ₹1.25 Lakh for hospitalization.\n• Contact Nearest Range Forest Officer (RFO) or call Toll-Free Helpline: 1926."
                        android:textColor="@color/color_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Direct Kisan Call Center Action -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallKisanCallCenter"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/space_16"
                android:backgroundTint="@color/color_primary"
                android:fontFamily="@font/poppins_bold"
                android:text="Call Kisan Call Center (1800-180-1551)"
                android:textColor="@color/color_white"
                android:textSize="13sp"
                app:cornerRadius="10dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Global Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface"
        android:elevation="12dp"
        app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
        app:itemIconTint="@color/nav_item_color_state"
        app:itemTextColor="@color/nav_item_color_state"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
