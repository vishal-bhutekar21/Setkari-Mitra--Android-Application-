<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingVertical="@dimen/space_12">

        <!-- Frosted Glass Back Button -->
        <ImageButton
            android:id="@+id/btnGlassBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_circle_btn"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="@color/color_white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Insects &amp; Scorpions"
                android:textColor="@color/color_on_primary"
                android:textSize="@dimen/text_title" />

            <TextView
                android:id="@+id/tvHeaderSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="विषारी कीटक, विंचू व प्रथमोपचार"
                android:textColor="@color/color_primary_container"
                android:textSize="@dimen/text_caption" />

        </LinearLayout>

        <!-- Floating Language Switcher -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreatureLangToggle"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/color_primary_container"
            android:fontFamily="@font/poppins_bold"
            android:text="English"
            android:textColor="@color/color_on_primary_container"
            android:textSize="@dimen/text_caption"
            app:cornerRadius="@dimen/radius_full" />

    </LinearLayout>

    <!-- Search View Bar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin_horizontal"
        android:layout_marginTop="@dimen/space_10"
        app:cardBackgroundColor="@color/color_surface"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchViewCreatures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:iconifiedByDefault="false"
            app:queryHint="Search scorpion, beetle, caterpillar, विंचू, कीटक..." />

    </com.google.android.material.card.MaterialCardView>

    <!-- Content List -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewCreatures"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="@dimen/space_8"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tvEmptyCreatures"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/poppins_regular"
            android:text="No harmful creatures found matching search"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
