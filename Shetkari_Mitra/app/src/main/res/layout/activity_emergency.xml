<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <!-- Top Emergency Header Bar -->
    <LinearLayout
        android:id="@+id/emergencyHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/color_emergency"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingTop="@dimen/space_32"
        android:paddingBottom="@dimen/space_16">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_glass_circle_btn"
                android:backgroundTint="#30FFFFFF"
                android:contentDescription="Back"
                android:src="@drawable/baseline_clear_24"
                app:tint="@color/color_white" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:letterSpacing="0.04"
                    android:text="EMERGENCY PROTOCOL"
                    android:textColor="@color/color_white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvEmergencySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Life-Saving First Aid Steps"
                    android:textColor="#F0FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Large Title Banner -->
        <TextView
            android:id="@+id/tvEmergencyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/emergency_mode_title"
            android:textColor="@color/color_white"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvEmergencyDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/emergency_mode_subtitle"
            android:textColor="#F0FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Scrollable Protocol Guidance -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/persistentEmergencyActions"
        android:layout_below="@id/emergencyHeader"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <!-- Section 1: 4 Immediate Action Steps -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="IMMEDIATE ACTIONS (काय करावे)"
                android:textColor="@color/color_text_primary"
                android:textSize="14sp" />

            <!-- Step 1 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/color_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_12">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_feature_icon_circle"
                        android:backgroundTint="@color/color_primary_container"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/color_on_primary_container"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/emergency_step1_title"
                            android:textColor="@color/color_text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/emergency_step1_desc"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Step 2 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/color_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_12">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_feature_icon_circle"
                        android:backgroundTint="@color/color_primary_container"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/color_on_primary_container"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/emergency_step2_title"
                            android:textColor="@color/color_text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/emergency_step2_desc"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Step 3 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/color_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_12">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_feature_icon_circle"
                        android:backgroundTint="@color/color_primary_container"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/color_on_primary_container"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/emergency_step3_title"
                            android:textColor="@color/color_text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/emergency_step3_desc"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Step 4 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/color_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_12">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_feature_icon_circle"
                        android:backgroundTint="@color/color_primary_container"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center"
                        android:text="4"
                        android:textColor="@color/color_on_primary_container"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/emergency_step4_title"
                            android:textColor="@color/color_text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/emergency_step4_desc"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2: DO NOT DO SECTION (Red Dominant Warning Card) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                app:cardBackgroundColor="@color/color_emergency_container"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/color_emergency"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_14">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/emergency_do_not_title"
                        android:textColor="@color/color_emergency"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_6"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="❌ 1. Do NOT cut or blade the wound"
                        android:textColor="@color/color_emergency"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="❌ 2. Do NOT attempt to suck venom"
                        android:textColor="@color/color_emergency"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="❌ 3. Do NOT apply tight tourniquets or ropes"
                        android:textColor="@color/color_emergency"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="❌ 4. Do NOT use unverified home remedies or mantras"
                        android:textColor="@color/color_emergency"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="❌ 5. Do NOT delay hospital transport for anything"
                        android:textColor="@color/color_emergency"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_16" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Persistent Bottom Emergency Actions -->
    <LinearLayout
        android:id="@+id/persistentEmergencyActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/color_surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingVertical="@dimen/space_12">

        <!-- Call Ambulance (108 / 112) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCallAmbulance"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/color_emergency"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/emergency_btn_call_ambulance"
            android:textColor="@color/color_white"
            android:textSize="15sp"
            app:cornerRadius="10dp"
            app:icon="@drawable/call_logo"
            app:iconGravity="textStart"
            app:iconTint="@color/color_white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <!-- Find Nearby Hospital -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFindHospitals"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1"
                android:backgroundTint="@color/color_primary_container"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/emergency_btn_find_help"
                android:textColor="@color/color_on_primary_container"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:icon="@drawable/hospital_location_logo"
                app:iconGravity="textStart" />

            <!-- Share SOS Location -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareSosLocation"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/emergency_btn_share_location"
                android:textColor="@color/color_text_primary"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:icon="@drawable/share_icon"
                app:iconGravity="textStart"
                app:strokeColor="@color/color_primary" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
