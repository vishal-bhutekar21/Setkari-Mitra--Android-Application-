    <!-- Emergency Mode Strings -->
    <string name="emergency_mode_title">Possible Snakebite?</string>
    <string name="emergency_mode_subtitle">Follow these life-saving steps immediately. Stay calm.</string>
    <string name="emergency_step1_title">Step 1: Move Away &amp; Stay Safe</string>
    <string name="emergency_step1_desc">Move away from the snake to a safe distance. Do not attempt to catch or kill it.</string>
    <string name="emergency_step2_title">Step 2: Keep Calm &amp; Minimize Movement</string>
    <string name="emergency_step2_desc">Keep the affected person calm. Keep the bitten limb completely still below heart level.</string>
    <string name="emergency_step3_title">Step 3: Remove Tight Items</string>
    <string name="emergency_step3_desc">Remove tight items such as rings, bangles, watches, or tight clothing if swelling occurs.</string>
    <string name="emergency_step4_title">Step 4: Seek Urgent Medical Care</string>
    <string name="emergency_step4_desc">Immediately transport victim to nearest Anti-Snake Venom (ASV) hospital. Do not walk.</string>
    <string name="emergency_do_not_title">AVOID THESE HARMFUL ACTIONS</string>
    <string name="emergency_dont_1">Do NOT cut the wound or make incisions.</string>
    <string name="emergency_dont_2">Do NOT attempt to suck venom by mouth or syringe.</string>
    <string name="emergency_dont_3">Do NOT apply tight tourniquets or ropes.</string>
    <string name="emergency_dont_4">Do NOT delay urgent medical care for rituals or quacks.</string>
    <string name="emergency_dont_5">Do NOT use unverified herbal or home remedies.</string>
    <string name="emergency_btn_call_ambulance">CALL AMBULANCE (108 / 112)</string>
    <string name="emergency_btn_find_help">FIND NEARBY HOSPITAL</string>
    <string name="emergency_btn_share_location">SHARE SOS LOCATION</string>

