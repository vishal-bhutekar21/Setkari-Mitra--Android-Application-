<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Primary application theme -->
    <style name="Theme.ShetkariMitra" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary_dark</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorPrimaryContainer">@color/color_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/color_on_primary_container</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorOnSecondary">@color/color_on_secondary</item>
        <item name="colorSecondaryContainer">@color/color_secondary_container</item>

        <!-- Background and surface -->
        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant</item>

        <!-- Error -->
        <item name="colorError">@color/color_error</item>
        <item name="colorOnError">@color/color_on_error</item>
        <item name="colorErrorContainer">@color/color_error_container</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/color_text_primary</item>
        <item name="android:textColorSecondary">@color/color_text_secondary</item>
        <item name="android:textColorHint">@color/color_text_hint</item>

        <!-- Status and navigation bar -->
        <item name="android:statusBarColor">@color/color_status_bar</item>
        <item name="android:navigationBarColor">@color/color_background</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:windowActivityTransitions">true</item>

        <!-- Shapes -->
        <item name="shapeAppearanceSmallComponent">@style/Shape.ShetkariMitra.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.ShetkariMitra.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/Shape.ShetkariMitra.Large</item>
    </style>

    <!-- Shapes -->
    <style name="Shape.ShetkariMitra.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">8dp</item>
    </style>
    <style name="Shape.ShetkariMitra.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">12dp</item>
    </style>
    <style name="Shape.ShetkariMitra.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">16dp</item>
    </style>
    <style name="Shape.ShetkariMitra.Full" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Splash theme (no action bar, status bar transparent) -->
    <style name="Theme.ShetkariMitra.Splash" parent="Theme.ShetkariMitra">
        <item name="android:statusBarColor">@color/color_primary</item>
        <item name="android:windowBackground">@color/color_primary</item>
    </style>

    <!-- Toolbar overlay theme -->
    <style name="ThemeOverlay.ShetkariMitra.Toolbar" parent="ThemeOverlay.Material3.ActionBar">
        <item name="android:textColorPrimary">@color/color_on_primary</item>
        <item name="android:textColorSecondary">@color/color_on_primary</item>
        <item name="colorControlNormal">@color/color_on_primary</item>
    </style>

</resources>