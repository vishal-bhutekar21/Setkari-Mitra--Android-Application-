<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Camera -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- SMS for emergency contact -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Storage for OSMDroid tile cache (API 26-28 only) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <!-- Notifications (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Hardware features (not required — app degrades gracefully) -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".ShetkariMitraApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/app_logo_main"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/app_logo_main_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShetkariMitra"
        tools:targetApi="34">

        <!-- Splash — launcher entry point -->
        <activity
            android:name=".SplashScreenActivity"
            android:exported="true"
            android:windowSoftInputMode="stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding Carousel -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false" />

        <!-- Auth (Login / Signup) -->
        <activity
            android:name=".Start_Activity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Home -->
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden" />

        <!-- Dedicated Emergency Mode -->
        <activity
            android:name=".EmergencyActivity"
            android:exported="false" />

        <!-- Snake Guide -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Snake Detail -->
        <activity
            android:name=".DetailActivity"
            android:exported="false" />

        <!-- First Aid -->
        <activity
            android:name=".First_Aid"
            android:exported="false" />

        <!-- Identify Snake -->
        <activity
            android:name=".Acitivity_identify_snake"
            android:exported="false" />

        <!-- Maps (OpenStreetMap) -->
        <activity
            android:name=".MapsActivity"
            android:exported="false" />

        <!-- Nearby Hospitals (list) -->
        <activity
            android:name=".Near_By_Hospitals"
            android:exported="false" />

        <!-- Safety Center & Checklists -->
        <activity
            android:name=".SafetyCenterActivity"
            android:exported="false" />

        <!-- Rescuer Request Workflow -->
        <activity
            android:name=".RescuerRequestActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Government & District Portals -->
        <activity
            android:name=".GovtPortalsActivity"
            android:exported="false" />

        <!-- Government Farmer Insurance Scheme -->
        <activity
            android:name=".GovtCompensationActivity"
            android:exported="false" />

        <!-- Safety Learning & Video Academy -->
        <activity
            android:name=".SafetyLearningActivity"
            android:exported="false" />

        <!-- Community Snake Sightings -->
        <activity
            android:name=".CommunitySightingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Emergency Contacts -->
        <activity
            android:name=".nav_Emergency_Contacts"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Rescuer Database -->
        <activity
            android:name=".RescuerDatabaseActivity"
            android:exported="false" />

        <!-- Rescuer Registration -->
        <activity
            android:name=".Registration_example"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Hospital Registration (admin) -->
        <activity
            android:name=".HospitalRegistrationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- About Us -->
        <activity
            android:name=".Activity_About_Us"
            android:exported="false" />

        <!-- Myths vs Facts Educational Module -->
        <activity
            android:name=".Activity_Myths_Facts"
            android:exported="false" />

        <!-- Harmful Insects & Scorpions Module -->
        <activity
            android:name=".HarmfulCreaturesActivity"
            android:exported="false" />

        <!-- FileProvider for camera and image sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>